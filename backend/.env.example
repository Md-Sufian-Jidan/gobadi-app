# Database connection configurations
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DATABASE=gobadi

# Redis cache connection configurations
REDIS_HOST=localhost
REDIS_PORT=6379

# Meilisearch connection (optional; falls back to database ILike search if unset).
# docker-compose runs a local instance at http://localhost:7700 with this key.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key

# JWT authentication configuration
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OAuth configurations (required for Google/Facebook sign-in; create these in
# Google Cloud Console / Meta for Developers - not committed here)
# Provide whichever of these your app requests ID tokens for (Web/iOS/Android
# clients each produce a different `aud` claim, so the backend must know all of them)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary configurations for bulk image storage (optional, uses fallback if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend API (https://resend.com/docs/api-reference/emails/send-email) — sends
# over HTTPS instead of raw SMTP, since some hosts (Render's free tier) block
# outbound SMTP ports entirely. Optional; falls back to mock console logs if empty.
RESEND_API_KEY=
SMTP_FROM="Gobadi App <no-reply@yourdomain.com>"

# OpenWeatherMap API key (optional, falls back to mock weather data if blank)
OPENWEATHER_API_KEY=

# OpenAI API key for real AI diagnosis (vision + symptoms) in ai-diagnosis module.
# Optional; falls back to a simple keyword heuristic if blank or the call fails.
OPENAI_API_KEY=